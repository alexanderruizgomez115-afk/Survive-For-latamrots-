-- ================= HITBOX CON BAT (NO MATA) =================
local function hasBat()
    for _,t in ipairs(Character:GetChildren()) do
        if t:IsA("Tool") and t.Name:lower():find("bat") then
            return true
        end
    end
end

local function push(hrp)
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5,1e5,1e5)
    bv.Velocity = (hrp.Position - HRP.Position).Unit * HITBOX_FORCE + Vector3.new(0,18,0)
    bv.Parent = hrp
    Debris:AddItem(bv,0.25)
end

RunService.RenderStepped:Connect(function()
    if not HITBOX_ENABLED or not hasBat() then return end

    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {Character}
    params.FilterType = Enum.RaycastFilterType.Blacklist

    local r = Workspace:Raycast(Camera.CFrame.Position, Camera.CFrame.LookVector * HITBOX_RANGE, params)
    if r and r.Instance then
        local m = r.Instance:FindFirstAncestorOfClass("Model")
        if m and m ~= Character and not HITBOX_COOLDOWN[m] then
            local hrp = m:FindFirstChild("HumanoidRootPart")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if hrp and hum then
                HITBOX_COOLDOWN[m] = true
                push(hrp)
                task.delay(HITBOX_CD,function()
                    HITBOX_COOLDOWN[m] = nil
                end)
            end
        end
    end
end)

