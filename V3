-- ================= PLAYER VISION =================
local rainbowCons = {}

local function overhead(plr)
    if plr == LocalPlayer or not plr.Character then return end
    local head = plr.Character:FindFirstChild("Head")
    if not head or head:FindFirstChild("RainbowName") then return end

    local gui = Instance.new("BillboardGui", head)
    gui.Name = "RainbowName"
    gui.Size = UDim2.new(0,95,0,20)
    gui.StudsOffset = Vector3.new(0,2.5,0)
    gui.AlwaysOnTop = true

    local txt = Instance.new("TextLabel", gui)
    txt.Size = UDim2.new(1,0,1,0)
    txt.BackgroundTransparency = 1
    txt.Text = plr.Name
    txt.Font = Enum.Font.GothamBold
    txt.TextScaled = true

    local stroke = Instance.new("UIStroke", txt)
    stroke.Thickness = 0.8

    local h = 0
    rainbowCons[plr] = RunService.RenderStepped:Connect(function()
        h = (h + 0.004) % 1
        txt.TextColor3 = Color3.fromHSV(h,1,1)
    end)
end

PlayerTab:CreateToggle({
    Name = "Players Visión (Rainbow)",
    Callback = function(v)
        if v then
            for _,p in ipairs(Players:GetPlayers()) do
                if p.Character then overhead(p) end
                p.CharacterAdded:Connect(function()
                    task.wait(0.3)
                    overhead(p)
                end)
            end
        else
            for _,p in ipairs(Players:GetPlayers()) do
                if p.Character and p.Character:FindFirstChild("Head") then
                    local g = p.Character.Head:FindFirstChild("RainbowName")
                    if g then g:Destroy() end
                end
                if rainbowCons[p] then
                    rainbowCons[p]:Disconnect()
                    rainbowCons[p] = nil
                end
            end
        end
    end
})

